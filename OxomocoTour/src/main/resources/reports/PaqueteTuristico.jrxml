<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
			  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                                  http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
			  name="PaqueteTuristicoReport"
			  language="java"
			  pageWidth="595"
			  pageHeight="842"
			  columnWidth="555"
			  leftMargin="20"
			  rightMargin="20"
			  topMargin="20"
			  bottomMargin="20">

	<!-- ESTILOS (antes de campos y parámetros) -->
	<style name="Title" fontName="Arial" fontSize="18" isBold="true"/>
	<style name="ColumnHeader" fontName="Arial" fontSize="12" isBold="true"/>
	<style name="Detail" fontName="Arial" fontSize="11"/>

	<!-- PARÁMETROS -->
	<parameter name="ReportTitle" class="java.lang.String"/>

	<!-- CAMPOS -->
	<field name="nombre" class="java.lang.String"/>
	<field name="destino" class="com.tuempresa.OxomocoTour.modelo.Destino"/>
	<field name="tarifa" class="java.math.BigDecimal"/>
	<field name="fechaInicio" class="java.time.LocalDate"/>
	<field name="fechaFin" class="java.time.LocalDate"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="cupoTotal" class="java.lang.Integer"/>
	<field name="cupoReservado" class="java.lang.Integer"/>
	<field name="cupoDisponible" class="java.lang.Integer"/>
	<field name="descripcionActividades" class="java.lang.String"/>
	<field name="descripcionProveedores" class="java.lang.String"/>

	<!-- TITLE BAND -->
	<title>
		<band height="50">
			<staticText>
				<reportElement x="0" y="10" width="555" height="30" style="Title"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[$P{ReportTitle}]]></text>
			</staticText>
		</band>
	</title>

	<!-- COLUMN HEADERS -->
	<columnHeader>
		<band height="30">
			<staticText>
				<reportElement x="0" y="0" width="100" height="30" style="ColumnHeader"/>
				<text><![CDATA[Nombre]]></text>
			</staticText>
			<staticText>
				<reportElement x="100" y="0" width="80" height="30" style="ColumnHeader"/>
				<text><![CDATA[Destino]]></text>
			</staticText>
			<staticText>
				<reportElement x="180" y="0" width="70" height="30" style="ColumnHeader"/>
				<text><![CDATA[Tarifa]]></text>
			</staticText>
			<staticText>
				<reportElement x="250" y="0" width="70" height="30" style="ColumnHeader"/>
				<text><![CDATA[Inicio]]></text>
			</staticText>
			<staticText>
				<reportElement x="320" y="0" width="70" height="30" style="ColumnHeader"/>
				<text><![CDATA[Fin]]></text>
			</staticText>
			<staticText>
				<reportElement x="390" y="0" width="80" height="30" style="ColumnHeader"/>
				<text><![CDATA[Cupo Disp.]]></text>
			</staticText>
			<staticText>
				<reportElement x="470" y="0" width="85" height="30" style="ColumnHeader"/>
				<text><![CDATA[Descripción]]></text>
			</staticText>
		</band>
	</columnHeader>

	<!-- DETAIL BAND -->
	<detail>
		<band height="25">
			<textField>
				<reportElement x="0" y="0" width="100" height="25" style="Detail"/>
				<textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="100" y="0" width="80" height="25" style="Detail"/>
				<textFieldExpression><![CDATA[$F{destino}.getNombre()]]></textFieldExpression>
			</textField>
			<textField pattern="$ #,##0.00">
				<reportElement x="180" y="0" width="70" height="25" style="Detail"/>
				<textFieldExpression><![CDATA[$F{tarifa}]]></textFieldExpression>
			</textField>
			<textField pattern="yyyy-MM-dd">
				<reportElement x="250" y="0" width="70" height="25" style="Detail"/>
				<textFieldExpression><![CDATA[$F{fechaInicio}]]></textFieldExpression>
			</textField>
			<textField pattern="yyyy-MM-dd">
				<reportElement x="320" y="0" width="70" height="25" style="Detail"/>
				<textFieldExpression><![CDATA[$F{fechaFin}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="390" y="0" width="80" height="25" style="Detail"/>
				<textFieldExpression><![CDATA[$F{cupoDisponible}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="470" y="0" width="85" height="25" style="Detail"/>
				<textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<!-- SUMMARY BAND -->
	<summary>
		<band height="30">
			<staticText>
				<reportElement x="0" y="0" width="555" height="30" style="Title"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[Fin del Reporte]]></text>
			</staticText>
		</band>
	</summary>

</jasperReport>
